// ─── Muqabaleh (مقابلة) — Full Data Model ───
// PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ───
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String?
  image                String?
  country              String?
  industry             String?
  experience           String?
  interviewerGender    String    @default("MALE")
  language             String    @default("AR")
  accountType          String    @default("INDIVIDUAL")
  role                 String    @default("USER")
  companyId            String?
  company              Company?  @relation(fields: [companyId], references: [id])
  sessionsLeft         Int       @default(1)
  subscriptionTier     String    @default("FREE")
  subscriptionExpiresAt DateTime?
  isActive             Boolean   @default(true)
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments             Payment[]
  interviews           Interview[]
  interviewerProfile   InterviewerProfile?
  auditLogs            AuditLog[]  @relation("ActorLogs")
  createdB2bJobs       B2BJob[]    @relation("JobCreator")
  paypalSubscriptions  PaypalSubscription[]
  candidatePool        CandidatePool?

  @@index([companyId])
}

// ─── Company ───
model Company {
  id          String           @id @default(cuid())
  name        String
  size        String           @default("SMALL")
  industry    String
  country     String
  plan        String           @default("B2B_STARTER")
  credits     Int              @default(0)
  slaHours    Int              @default(72)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  panel       CompanyPanel[]
  b2bJobs     B2BJob[]
}

// ─── CompanyPanel ───
model CompanyPanel {
  companyId     String
  interviewerId String
  company       Company            @relation(fields: [companyId], references: [id])
  interviewer   InterviewerProfile @relation(fields: [interviewerId], references: [id])

  @@id([companyId, interviewerId])
}

// ─── Interview ───
model Interview {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id])
  companyId            String?
  guestToken           String?   @unique
  guestName            String?
  guestEmail           String?
  mode                 String    @default("AI")
  type                 String
  industry             String
  experience           String?
  position             String?
  language             String    @default("AR")
  interviewerGender    String    @default("MALE")
  status               String    @default("PENDING")
  overallScore         Int?
  contentScore         Int?
  clarityScore         Int?
  confidenceScore      Int?
  culturalFitScore     Int?
  feedback             String?
  strengths            String?
  improvements         String?
  recommendation       String?
  sessionDebited       Boolean   @default(false)
  verificationId       String?   @unique
  pdfUrl               String?
  b2bJobId             String?
  b2bJob               B2BJob?   @relation(fields: [b2bJobId], references: [id])
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  messages             Message[]

  @@index([userId])
  @@index([companyId])
}

// ─── Message ───
model Message {
  id          String   @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role        String
  content     String
  sequence    Int
  createdAt   DateTime @default(now())

  @@index([interviewId])
}

// ─── Payment ───
model Payment {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  companyId       String?
  packageType     String
  amountUsdCents  Int
  paypalOrderId   String   @unique
  status          String   @default("CREATED")
  sessionsCredited Int     @default(0)
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  capturedAt      DateTime?

  @@index([paypalOrderId])
}

// ─── Question ───
model Question {
  id          String   @id @default(cuid())
  textAr      String
  textEn      String
  industry    String
  type        String
  difficulty  String   @default("MEDIUM")
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── InterviewerProfile ───
model InterviewerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  slug              String    @unique
  bioAr             String
  bioEn             String
  industries        String
  languages         String
  yearsExperience   Int
  currentTitle      String
  photoUrl          String?
  sessionPriceUsdCents Int  @default(4900)
  status            String    @default("PENDING")
  avgRatingCents   Int      @default(0)
  totalSessions     Int      @default(0)
  payoutMethod      String?
  excludedCompanies String?
  excludedIndustries String?
  ndaAcceptedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  availabilities     Availability[]
  companyPanel       CompanyPanel[]

  @@index([status])
}

// ─── Availability ───
model Availability {
  id             String   @id @default(cuid())
  interviewerId  String
  interviewer    InterviewerProfile @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String
  timezone       String

  @@index([interviewerId])
}


// ─── PaypalSubscription ───
model PaypalSubscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paypalSubscriptionId String    @unique
  paypalPlanId         String
  status               String    @default("ACTIVE")
  startTime            DateTime?
  nextBillingTime      DateTime?
  payerEmail           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([paypalSubscriptionId])
}

// ─── B2BJob ───
model B2BJob {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  title             String
  industry          String
  type              String
  mode              String    @default("AI")
  assignmentMode    String    @default("AUTO")
  mustAskQuestions  String?
  humanPriceUsdCents Int?
  inviteDeadline    DateTime?
  createdById       String
  createdBy         User      @relation("JobCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  interviews        Interview[]

  @@index([companyId])
}

// ─── AuditLog ───
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  event     String
  metadata  String
  createdAt DateTime @default(now())

  @@index([actorId])
}

// ─── Human Interview Marketplace Models ───
model Interviewer {
  id              String   @id @default(uuid())
  userId          String   @unique
  status          String   @default("PENDING")
  fullName        String
  fullNameAr      String?
  bio             String?  @db.Text
  bioAr           String?  @db.Text
  linkedInUrl     String?
  phone           String?
  yearsExperience Int
  specialties     String
  industries      String
  languages       String   @default("AR")
  priceTier       String   @default("STANDARD")
  hourlyRate      Int      @default(2900)
  rating          Float    @default(0)
  totalInterviews Int      @default(0)
  totalEarnings   Int      @default(0)
  videoIntroUrl   String?
  idDocumentUrl   String?
  idVerified      Boolean  @default(false)
  payoutEmail     String?
  payoutMethod    String   @default("PAYPAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  availability    InterviewerAvailability[] @relation("InterviewerSlots")
  reviews         InterviewerReview[]        @relation("InterviewerReviews")
  humanBookings   HumanBooking[]             @relation("InterviewerBookings")
  payouts         InterviewerPayout[]         @relation("InterviewerPayouts")
}

model InterviewerAvailability {
  id            String    @id @default(uuid())
  interviewerId String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())

  interviewer   Interviewer @relation("InterviewerSlots", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewerId])
}

model HumanBooking {
  id                String   @id @default(uuid())
  userId            String?
  candidateName     String
  candidateEmail    String
  interviewerId     String
  paypalOrderId     String?  @unique
  status            String   @default("PENDING")
  scheduledAt       DateTime
  durationMinutes   Int      @default(30)
  priceTotal        Int
  platformFee       Int
  interviewerPayout Int
  provider          String   @default("JITSI")
  dailyRoomUrl     String?
  dailyRoomName    String?
  recordingUrl     String?
  meetingLink       String?
  candidateNote     String?  @db.Text
  interviewerNotes  String?  @db.Text
  candidateFeedback String?  @db.Text
  candidateRating   Int?
  interviewerRating Int?
  disputeReason     String?
  cancelledBy       String?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  interviewer   Interviewer @relation("InterviewerBookings", fields: [interviewerId], references: [id])
  review        InterviewerReview?

  @@index([userId])
  @@index([interviewerId])
  @@index([status])
}

model InterviewerReview {
  id            String   @id @default(uuid())
  interviewerId String
  bookingId     String   @unique
  rating        Int
  comment       String?  @db.Text
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())

  interviewer   Interviewer  @relation("InterviewerReviews", fields: [interviewerId], references: [id])
  booking       HumanBooking @relation(fields: [bookingId], references: [id])

  @@index([interviewerId])
}

model InterviewerPayout {
  id                  String   @id @default(uuid())
  interviewerId       String
  amount              Int
  status              String   @default("PENDING")
  paidAt              DateTime?
  paypalTransactionId String?
  periodStart         DateTime
  periodEnd           DateTime
  createdAt           DateTime @default(now())

  interviewer   Interviewer @relation("InterviewerPayouts", fields: [interviewerId], references: [id])

  @@index([interviewerId])
  @@index([status])
}

// ─── Admin Log ───
model AdminLog {
  id          String   @id @default(cuid())
  action      String
  adminEmail  String
  targetType  String?
  targetId    String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
}

// ─── Email Queue (Scheduled Emails) ───
model EmailQueue {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String    @db.Text
  from      String?
  sendAt    DateTime
  sent      Boolean   @default(false)
  sentAt    DateTime?
  error     String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([sent, sendAt])
}

// ─── Candidate Pool (Opt-In) ───
model CandidatePool {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOptedIn       Boolean   @default(false)
  isVisible       Boolean   @default(false)
  role            String
  level           String
  industry        String?
  location        String?
  muqabalehScore  Float?
  averageScore    Float?
  interviewCount  Int       @default(0)
  languages       String    @default("AR")
  availability    String    @default("AVAILABLE") // AVAILABLE, OPEN_TO_OFFERS, NOT_LOOKING
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isVisible])
  @@index([role])
  @@index([muqabalehScore])
}
