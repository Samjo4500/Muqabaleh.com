// ─── Muqabaleh (مقابلة) — Full Data Model ───
// PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ───
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String?
  image                String?
  country              String?
  industry             String?
  experience           String?
  interviewerGender    String    @default("MALE")
  language             String    @default("AR")
  accountType          String    @default("INDIVIDUAL")
  role                 String    @default("USER")
  companyId            String?
  company              Company?  @relation(fields: [companyId], references: [id])
  sessionsLeft         Int       @default(1)
  subscriptionTier     String    @default("FREE")
  subscriptionExpiresAt DateTime?
  isActive             Boolean   @default(true)
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments             Payment[]
  interviews           Interview[]
  humanBookings        HumanBooking[]
  interviewerProfile   InterviewerProfile?
  auditLogs            AuditLog[]  @relation("ActorLogs")
  createdB2bJobs       B2BJob[]    @relation("JobCreator")
  paypalSubscriptions  PaypalSubscription[]

  @@index([companyId])
}

// ─── Company ───
model Company {
  id          String           @id @default(cuid())
  name        String
  size        String           @default("SMALL")
  industry    String
  country     String
  plan        String           @default("B2B_STARTER")
  credits     Int              @default(0)
  slaHours    Int              @default(72)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  panel       CompanyPanel[]
  b2bJobs     B2BJob[]
}

// ─── CompanyPanel ───
model CompanyPanel {
  companyId     String
  interviewerId String
  company       Company            @relation(fields: [companyId], references: [id])
  interviewer   InterviewerProfile @relation(fields: [interviewerId], references: [id])

  @@id([companyId, interviewerId])
}

// ─── Interview ───
model Interview {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id])
  companyId            String?
  humanBookingId       String?
  humanBooking         HumanBooking? @relation(fields: [humanBookingId], references: [id])
  guestToken           String?   @unique
  guestName            String?
  guestEmail           String?
  mode                 String    @default("AI")
  type                 String
  industry             String
  experience           String?
  position             String?
  language             String    @default("AR")
  interviewerGender    String    @default("MALE")
  status               String    @default("PENDING")
  overallScore         Int?
  contentScore         Int?
  clarityScore         Int?
  confidenceScore      Int?
  culturalFitScore     Int?
  feedback             String?
  strengths            String?
  improvements         String?
  recommendation       String?
  sessionDebited       Boolean   @default(false)
  verificationId       String?   @unique
  pdfUrl               String?
  b2bJobId             String?
  b2bJob               B2BJob?   @relation(fields: [b2bJobId], references: [id])
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  messages             Message[]

  @@index([userId])
  @@index([companyId])
}

// ─── Message ───
model Message {
  id          String   @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role        String
  content     String
  sequence    Int
  createdAt   DateTime @default(now())

  @@index([interviewId])
}

// ─── Payment ───
model Payment {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  companyId       String?
  packageType     String
  amountUsdCents  Int
  paypalOrderId   String   @unique
  status          String   @default("CREATED")
  sessionsCredited Int     @default(0)
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  capturedAt      DateTime?

  @@index([paypalOrderId])
}

// ─── Question ───
model Question {
  id          String   @id @default(cuid())
  textAr      String
  textEn      String
  industry    String
  type        String
  difficulty  String   @default("MEDIUM")
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── InterviewerProfile ───
model InterviewerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  slug              String    @unique
  bioAr             String
  bioEn             String
  industries        String
  languages         String
  yearsExperience   Int
  currentTitle      String
  photoUrl          String?
  sessionPriceUsdCents Int  @default(4900)
  status            String    @default("PENDING")
  avgRatingCents   Int      @default(0)
  totalSessions     Int      @default(0)
  payoutMethod      String?
  excludedCompanies String?
  excludedIndustries String?
  ndaAcceptedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  availabilities     Availability[]
  humanBookings      HumanBooking[]
  companyPanel       CompanyPanel[]

  @@index([status])
}

// ─── Availability ───
model Availability {
  id             String   @id @default(cuid())
  interviewerId  String
  interviewer    InterviewerProfile @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String
  timezone       String

  @@index([interviewerId])
}

// ─── HumanBooking ───
model HumanBooking {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id])
  companyId            String?
  b2bJobId             String?
  interviewerId        String
  interviewer          InterviewerProfile @relation(fields: [interviewerId], references: [id])
  candidateName        String?
  candidateEmail       String?
  startsAt             DateTime
  endsAt               DateTime
  status               String    @default("REQUESTED")
  meetingUrl           String?
  priceUsdCents        Int
  interviewerPayoutCents Int?
  paypalOrderId        String?
  rating               Int?
  ratingComment        String?
  payoutStatus        String    @default("NOT_DUE")
  payoutNote          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  interviews           Interview[]

  @@unique([interviewerId, startsAt])
  @@index([interviewerId])
}

// ─── PaypalSubscription ───
model PaypalSubscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paypalSubscriptionId String    @unique
  paypalPlanId         String
  status               String    @default("ACTIVE")
  startTime            DateTime?
  nextBillingTime      DateTime?
  payerEmail           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([paypalSubscriptionId])
}

// ─── B2BJob ───
model B2BJob {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  title             String
  industry          String
  type              String
  mode              String    @default("AI")
  assignmentMode    String    @default("AUTO")
  mustAskQuestions  String?
  humanPriceUsdCents Int?
  inviteDeadline    DateTime?
  createdById       String
  createdBy         User      @relation("JobCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  interviews        Interview[]

  @@index([companyId])
}

// ─── AuditLog ───
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  event     String
  metadata  String
  createdAt DateTime @default(now())

  @@index([actorId])
}
