// ─── Muqabaleh (مقابلة) — Full Data Model ───
// PostgreSQL (Supabase)
// P0.5: enums + FK integrity (preserves production auth/billing fields)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum UserRole {
  USER
  INTERVIEWER
  ADMIN
  SUPER_ADMIN
  COMPANY_ADMIN
  PARTNER_ADMIN
  PARTNER_MEMBER
}

enum UserTier {
  FREE
  BASIC
  PRO
  PREMIUM
  UNLIMITED
  JEANNIE
  JEANNIE_PRO
}

enum JeannieOpportunityStatus {
  SUGGESTED
  AWAITING_APPROVAL
  APPROVED
  APPLYING
  APPLIED
  REJECTED_BY_USER
  EXPIRED
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
  REFUNDED
}

enum InterviewerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum PaymentType {
  AI_PACKAGE
  BOOKING
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum JobPostingStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStage {
  NEW
  REVIEWING
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

// ─── User ───
// Keeps passwordHash/sessionsLeft/interview relations required by production auth & AI flow.
// Prompt's simplified User is extended — not gutted — so login/billing keep working.
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String?
  image                 String?
  country               String?
  industry              String?
  experience            String?
  interviewerGender     String    @default("MALE")
  language              String    @default("AR")
  accountType           String    @default("INDIVIDUAL")
  role                  UserRole  @default(USER)
  companyId             String?
  company               Company?  @relation(fields: [companyId], references: [id])
  partnerId             String?
  partner               Partner?  @relation(fields: [partnerId], references: [id])
  sessionsLeft          Int       @default(1)
  tier                  UserTier  @default(FREE)
  /// Monthly Jeannie approve-gated apply quota remaining.
  appliesLeft           Int       @default(0)
  /// When the monthly apply quota resets.
  appliesResetAt        DateTime?
  /// Jeannie Pro: CV studio / improve tools.
  cvStudioEnabled       Boolean   @default(false)
  /// Jeannie Pro: cover letter generate + assist.
  coverLetterAiEnabled  Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  isActive              Boolean   @default(true)
  passwordResetToken    String?
  passwordResetExpiry   DateTime?
  /// TOTP secret for SUPER_ADMIN 2FA (base32). Null until enrolled.
  totpSecret            String?
  totpEnabled           Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  payments               Payment[]
  interviews             Interview[]
  interviewer            Interviewer?
  humanBookings          HumanBooking[]
  payouts                InterviewerPayout[]
  auditLogs              AuditLog[]           @relation("ActorLogs")
  createdB2bJobs         B2BJob[]             @relation("JobCreator")
  paypalSubscriptions    PaypalSubscription[]
  candidatePool          CandidatePool?
  adminRoleAssignments   AdminRoleAssignment[]
  adminAuditLogs         AdminAuditLog[]      @relation("AdminAuditActor")
  supportTicketsAssigned SupportTicket[]      @relation("TicketAssignee")
  supportTicketsCreated  SupportTicket[]      @relation("TicketCreator")
  interviewPrequals      InterviewPrequal[]
  interviewSessions      InterviewSession[]
  jobApplications        JobApplication[]
  mediaAssets            MediaAsset[]
  jeannieProfile         JeannieProfile?
  jeannieOpportunities   JeannieOpportunity[]
  jeannieDocuments       JeannieDocument[]

  @@index([companyId])
  @@index([partnerId])
  @@index([lockedUntil])
}

// ─── Company ───
model Company {
  id        String   @id @default(cuid())
  name      String
  size      String   @default("SMALL")
  industry  String
  country   String
  plan      String   @default("B2B_STARTER")
  credits   Int      @default(0)
  slaHours  Int      @default(72)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  panel   CompanyPanel[]
  b2bJobs B2BJob[]

  @@index([partnerId])
  @@index([status])
}

// ─── CompanyPanel (now points at marketplace Interviewer) ───
model CompanyPanel {
  companyId     String
  interviewerId String
  company       Company     @relation(fields: [companyId], references: [id])
  interviewer   Interviewer @relation(fields: [interviewerId], references: [id])

  @@id([companyId, interviewerId])
}

// ─── Interview ───
model Interview {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  companyId        String?
  guestToken       String?   @unique
  guestName        String?
  guestEmail       String?
  mode             String    @default("AI")
  type             String
  industry         String
  experience       String?
  position         String?
  language         String    @default("AR")
  interviewerGender String   @default("MALE")
  status           String    @default("PENDING")
  overallScore     Int?
  contentScore     Int?
  clarityScore     Int?
  confidenceScore  Int?
  culturalFitScore Int?
  feedback         String?
  strengths        String?
  improvements     String?
  recommendation   String?
  sessionDebited   Boolean   @default(false)
  verificationId   String?   @unique
  pdfUrl           String?
  b2bJobId         String?
  b2bJob           B2BJob?   @relation(fields: [b2bJobId], references: [id])
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages Message[]

  @@index([userId])
  @@index([companyId])
}

// ─── Message ───
model Message {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role        String
  content     String
  sequence    Int
  createdAt   DateTime  @default(now())

  @@index([interviewId])
}

// ─── Payment (AI packages, bookings, subscriptions) ───
model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                   PaymentType
  /// USD amount in dollars (e.g. 9.99). Migrated from amountUsdCents / 100.
  amount                 Float
  currency               String        @default("USD")
  status                 PaymentStatus @default(PENDING)
  paypalOrderId          String?       @unique
  paypalSubscriptionId   String?
  bookingId              String?
  booking                HumanBooking? @relation(fields: [bookingId], references: [id])
  /// Legacy AI package SKU (PRO, UNLIMITED, STANDARD_HUMAN, …)
  packageType            String?
  sessionsCredited       Int           @default(0)
  idempotencyKey         String?       @unique
  companyId              String?
  capturedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([paypalOrderId])
  @@index([userId])
  @@index([type])
  @@index([status])
}

// ─── Question ───
model Question {
  id         String   @id @default(cuid())
  textAr     String
  textEn     String
  industry   String
  type       String
  difficulty String   @default("MEDIUM")
  category   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── PaypalSubscription ───
model PaypalSubscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paypalSubscriptionId String    @unique
  paypalPlanId         String
  status               String    @default("ACTIVE")
  startTime            DateTime?
  nextBillingTime      DateTime?
  payerEmail           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([paypalSubscriptionId])
}

// ─── B2BJob ───
model B2BJob {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  title              String
  titleAr            String?
  industry           String
  type               String
  mode               String           @default("AI")
  assignmentMode     String           @default("AUTO")
  mustAskQuestions   String?
  humanPriceUsdCents Int?
  inviteDeadline     DateTime?
  /// Public ATS posting fields
  description        String?          @db.Text
  descriptionAr      String?          @db.Text
  requirements       String?          @db.Text
  benefits           String?          @db.Text
  location           String?
  city               String?
  /// ISO-ish MENA country code (SA, AE, …) or REMOTE
  country            String?
  department         String?
  employmentType     String           @default("fulltime")
  /// JUNIOR | MID | SENIOR | LEAD | EXECUTIVE
  careerLevel        String?
  salaryRange        String?
  tags               String?
  isPublic           Boolean          @default(false)
  isFeatured         Boolean          @default(false)
  status             JobPostingStatus @default(DRAFT)
  closesAt           DateTime?
  createdById        String
  createdBy          User             @relation("JobCreator", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  interviews   Interview[]
  applications JobApplication[]

  @@index([companyId])
  @@index([status, isPublic])
  @@index([city])
  @@index([country])
  @@index([department])
  @@index([careerLevel])
  @@index([industry])
  @@index([employmentType])
}

// ─── Media uploads (CV / photo) stored in Postgres for portability ───
model MediaAsset {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([kind])
}

// ─── Job applications (ATS pipeline) ───
model JobApplication {
  id           String           @id @default(cuid())
  jobId        String
  job          B2BJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage        ApplicationStage @default(NEW)
  coverLetter  String?          @db.Text
  cvAssetId    String?
  photoAssetId String?
  source       String           @default("DIRECT")
  employerNote String?          @db.Text
  score        Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
  @@index([candidateId])
  @@index([stage])
}

// ─── Jeannie career agent ───
model JeannieProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoles     String[] @default([])
  targetCities    String[] @default([])
  targetCountries String[] @default([])
  seniority       String?
  languages       String[] @default([])
  minSalary       Int?
  workModes       String[] @default([])
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model JeannieOpportunity {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           JeannieOpportunityStatus @default(SUGGESTED)
  b2bJobId         String?
  externalUrl      String?
  companyName      String
  title            String
  titleAr          String?
  city             String?
  country          String?
  matchScore       Int                      @default(0)
  matchReason      String?                  @db.Text
  matchReasonAr    String?                  @db.Text
  coverLetter      String?                  @db.Text
  cvAssetId        String?
  jobApplicationId String?
  failureReason    String?
  approvedAt       DateTime?
  appliedAt        DateTime?
  rejectedAt       DateTime?
  expiresAt        DateTime?
  idempotencyKey   String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([b2bJobId])
}

model JeannieDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  content   String   @db.Text
  contentAr String?  @db.Text
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

// ─── AuditLog ───
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  event     String
  metadata  String
  createdAt DateTime @default(now())

  @@index([actorId])
}

// ─── Unified Interviewer (marketplace + former InterviewerProfile fields) ───
// InterviewerProfile removed. Unique profile fields merged below as optional.
model Interviewer {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          InterviewerStatus @default(PENDING)
  fullName        String
  fullNameAr      String?
  bio             String?           @db.Text
  bioAr           String?           @db.Text
  /// Former InterviewerProfile.bioEn
  bioEn           String?           @db.Text
  /// Former InterviewerProfile.slug (public profile URL)
  slug            String?           @unique
  /// Former InterviewerProfile.currentTitle
  currentTitle    String?
  /// Former InterviewerProfile.photoUrl
  photoUrl        String?
  expertise       String?
  linkedInUrl     String?
  phone           String?
  yearsExperience Int
  specialties     String
  industries      String
  languages       String            @default("AR")
  priceTier       String            @default("STANDARD")
  /// Stored in USD cents (marketplace). Prompt "hourlyRate Float" kept as Int cents for money safety.
  hourlyRate      Int               @default(2900)
  /// Former InterviewerProfile.sessionPriceUsdCents
  sessionPriceUsdCents Int?
  rating          Float             @default(0)
  totalInterviews Int               @default(0)
  totalEarnings   Int               @default(0)
  videoIntroUrl   String?
  idDocumentUrl   String?
  idVerified      Boolean           @default(false)
  payoutEmail     String?
  payoutMethod    String            @default("PAYPAL")
  timezone        String?
  excludedCompanies  String?
  excludedIndustries String?
  ndaAcceptedAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  availability  InterviewerAvailability[] @relation("InterviewerSlots")
  reviews       InterviewerReview[]       @relation("InterviewerReviews")
  humanBookings HumanBooking[]            @relation("InterviewerBookings")
  payouts       InterviewerPayout[]       @relation("InterviewerPayouts")
  companyPanel  CompanyPanel[]

  @@index([status])
}

model InterviewerAvailability {
  id            String   @id @default(uuid())
  interviewerId String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())

  interviewer Interviewer @relation("InterviewerSlots", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewerId])
}

model HumanBooking {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateName     String
  candidateEmail    String
  interviewerId     String?
  interviewer       Interviewer?  @relation("InterviewerBookings", fields: [interviewerId], references: [id])
  paypalOrderId     String?       @unique
  status            BookingStatus @default(PENDING)
  scheduledAt       DateTime
  durationMinutes   Int           @default(30)
  /// USD cents (marketplace money path). Not Float dollars — avoids fee rounding bugs.
  priceTotal        Int
  platformFee       Int
  interviewerPayout Int
  provider          String        @default("JITSI")
  dailyRoomUrl      String?
  dailyRoomName     String?
  recordingUrl      String?
  earnings          Int           @default(0)
  meetingLink       String?
  candidateNote     String?       @db.Text
  interviewerNotes  String?       @db.Text
  candidateFeedback String?       @db.Text
  candidateRating   Int?
  interviewerRating Int?
  disputeReason     String?
  cancelledBy       String?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  review   InterviewerReview?
  payments Payment[]

  @@unique([interviewerId, scheduledAt])
  @@index([userId])
  @@index([interviewerId])
  @@index([status])
}

model InterviewerReview {
  id            String   @id @default(uuid())
  interviewerId String
  bookingId     String   @unique
  rating        Int
  comment       String?  @db.Text
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())

  interviewer Interviewer  @relation("InterviewerReviews", fields: [interviewerId], references: [id])
  booking     HumanBooking @relation(fields: [bookingId], references: [id])

  @@index([interviewerId])
}

model InterviewerPayout {
  id            String       @id @default(uuid())
  interviewerId String
  interviewer   Interviewer  @relation("InterviewerPayouts", fields: [interviewerId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  /// USD dollars
  amount        Float
  currency      String       @default("USD")
  status        PayoutStatus @default(PENDING)
  /// PayPal payout batch ID — REQUIRED for COMPLETED (enforced in API)
  batchId       String?
  /// HumanBooking IDs covered by this payout
  bookingIds    String[]     @default([])
  paypalEmail   String?
  adminNote     String?      @db.Text
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  completedAt   DateTime?
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([interviewerId])
  @@index([userId])
  @@index([status])
  @@index([batchId])
}

// ─── Admin Log ───
model AdminLog {
  id         String   @id @default(cuid())
  action     String
  adminEmail String
  targetType String?
  targetId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
}

// ─── Email Queue (Scheduled Emails) ───
model EmailQueue {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String    @db.Text
  from      String?
  sendAt    DateTime
  sent      Boolean   @default(false)
  sentAt    DateTime?
  error     String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([sent, sendAt])
}

// ─── Candidate Pool (Opt-In talent database for employers) ───
model CandidatePool {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOptedIn        Boolean  @default(false)
  isVisible        Boolean  @default(false)
  openToWork       Boolean  @default(true)
  role             String
  level            String
  industry         String?
  location         String?
  headline         String?
  summary          String?  @db.Text
  skills           String?
  yearsExperience  Int?
  phone            String?
  linkedInUrl      String?
  desiredRole      String?
  desiredLocations String?
  cvAssetId        String?
  cvFileName       String?
  photoAssetId     String?
  muqabalehScore   Float?
  averageScore     Float?
  interviewCount   Int      @default(0)
  languages        String   @default("AR")
  availability     String   @default("AVAILABLE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isVisible])
  @@index([openToWork])
  @@index([role])
  @@index([muqabalehScore])
  @@index([industry])
  @@index([location])
}

// ─── Super Admin Control Panel (Muqabaleh only) ───

model AdminRole {
  id          String   @id @default(cuid())
  key         String   @unique
  nameAr      String
  nameEn      String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AdminRoleAssignment[]

  @@map("admin_roles")
}

model AdminRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("admin_role_assignments")
}

/// Immutable admin audit trail — no updatedAt, no deletes from app code.
model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminAuditActor", fields: [adminId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PartnerApplication {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  website     String?
  country     String?
  message     String?  @db.Text
  status      String   @default("PENDING")
  notes       String?  @db.Text
  partnerId   String?  @unique
  partner     Partner? @relation(fields: [partnerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("partner_applications")
}

// ─── White-label Partner org ───
model Partner {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  legalName            String?
  status               String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | CHURNED
  plan                 String    @default("STARTER") // STARTER | GROWTH | ENTERPRISE
  contactName          String
  contactEmail         String    @unique
  contactPhone         String?
  website              String?
  country              String?
  // Branding
  logoUrl              String?
  faviconUrl           String?
  primaryColor         String    @default("#14B8A6")
  accentColor          String    @default("#D4A843")
  customDomain         String?   @unique
  customDomainVerified Boolean   @default(false)
  supportEmail         String?
  fromEmailName        String?
  // Commercial
  commissionBps        Int       @default(2000) // 20%
  creditsPool          Int       @default(50)
  currency             String    @default("USD")
  notes                String?   @db.Text
  activatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users        User[]
  companies    Company[]
  application  PartnerApplication?
  apiKeys      PartnerApiKey[]
  webhooks     PartnerWebhook[]
  payouts      PartnerPayout[]
  invoices     PartnerInvoice[]
  deliveries   PartnerWebhookDelivery[]

  @@index([status])
  @@index([plan])
  @@map("partners")
}

model PartnerApiKey {
  id         String    @id @default(cuid())
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name       String
  keyHint    String
  keyHash    String
  scopes     String[]  @default(["read", "write"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([partnerId])
  @@index([keyHash])
  @@map("partner_api_keys")
}

model PartnerWebhook {
  id             String    @id @default(cuid())
  partnerId      String
  partner        Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         String[]  @default(["interview.completed", "candidate.scored"])
  isActive       Boolean   @default(true)
  lastDeliveryAt DateTime?
  failureCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deliveries     PartnerWebhookDelivery[]

  @@index([partnerId])
  @@map("partner_webhooks")
}

model PartnerWebhookDelivery {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  webhookId  String
  webhook    PartnerWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  payload    Json     @default("{}")
  statusCode Int?
  success    Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([partnerId])
  @@index([webhookId])
  @@map("partner_webhook_deliveries")
}

model PartnerPayout {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([partnerId])
  @@index([status])
  @@map("partner_payouts")
}

model PartnerInvoice {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  number      String
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("OPEN") // OPEN | PAID | VOID
  description String?
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([partnerId, number])
  @@index([partnerId])
  @@map("partner_invoices")
}

model InterviewTemplate {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String
  descriptionAr String? @db.Text
  descriptionEn String? @db.Text
  industry    String
  level       String   @default("MID")
  durationMin Int      @default(30)
  isActive    Boolean  @default(true)
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industry])
  @@index([isActive])
  @@map("interview_templates")
}

model QuestionBankItem {
  id         String   @id @default(cuid())
  textAr     String   @db.Text
  textEn     String   @db.Text
  industry   String
  category   String?
  difficulty String   @default("MEDIUM")
  tags       String[] @default([])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([industry])
  @@index([isActive])
  @@map("question_bank")
}

model ScoringRubric {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String
  description String?  @db.Text
  criteria    Json     @default("[]")
  maxScore    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scoring_rubrics")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subjectAr String
  subjectEn String
  bodyAr    String   @db.Text
  bodyEn    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String   @default("EMAIL")
  recipient String
  subject   String?
  body      String?  @db.Text
  status    String   @default("QUEUED")
  meta      Json     @default("{}")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([recipient])
  @@index([createdAt])
  @@map("notification_logs")
}

model ApiKeyRecord {
  id         String    @id @default(cuid())
  provider   String
  label      String
  /// Encrypted or masked key material — never return full secret to client
  keyHint    String
  keyHash    String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([provider])
  @@map("api_keys")
}

model BackupLog {
  id        String   @id @default(cuid())
  type      String   @default("MANUAL")
  status    String   @default("PENDING")
  location  String?
  sizeBytes Int?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}

model SupportTicket {
  id           String   @id @default(cuid())
  subject      String
  body         String   @db.Text
  status       String   @default("OPEN")
  priority     String   @default("NORMAL")
  category     String?
  createdById  String?
  assigneeId   String?
  createdBy    User?    @relation("TicketCreator", fields: [createdById], references: [id])
  assignee     User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?

  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assigneeId])
  @@map("support_tickets")
}

model AiApiUsage {
  id           String   @id @default(cuid())
  provider     String   @default("gemini")
  model        String
  operation    String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimatedCostUsd Float @default(0)
  success      Boolean  @default(true)
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
  @@map("ai_api_usage")
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("admin_settings")
}

// ─── AI Mock Interview Engine (pre-qual → plan → session → report) ───

model InterviewPrequal {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Client tracking id for the pre-qual wizard (before InterviewSession exists)
  sessionId             String    @unique
  /// Snapshot of registered email at pre-qual time (required capture)
  userEmail             String
  targetRole            String
  targetRoleAr          String?
  seniorityLevel        String
  questionTypes         String[]
  interviewRound        String
  languagePreference    String
  targetIndustry        String?
  targetIndustryAr      String?
  weaknessFocus         String?
  weaknessFocusAr       String?
  durationPreset        String
  numQuestions          Int
  estimatedDurationMin  Int
  generatedPlan         Json?
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  interviewSession      InterviewSession?

  @@index([userId])
  @@index([sessionId])
  @@map("interview_prequal")
}

model InterviewQuestion {
  id                String   @id @default(uuid())
  questionText      String   @db.Text
  questionTextAr    String?  @db.Text
  answerTemplate    String?  @db.Text
  answerTemplateAr  String?  @db.Text
  roleCategory      String
  seniorityLevel    String
  questionType      String
  interviewRound    String
  difficulty        String
  tags              String[]
  industryContext   String?
  followUpQuestions Json?
  evaluationRubric  Json?
  timeLimitSeconds  Int
  coachingTips      String[]
  usageCount        Int      @default(0)
  avgScore          Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([roleCategory, seniorityLevel, questionType, interviewRound])
  @@index([difficulty])
  @@index([tags])
  @@map("interview_questions")
}

model InterviewSession {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prequalId            String              @unique
  prequal              InterviewPrequal    @relation(fields: [prequalId], references: [id], onDelete: Cascade)
  status               String              @default("pending")
  language             String
  numQuestionsTotal    Int
  numQuestionsAnswered Int                 @default(0)
  currentQuestionIndex Int                 @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  totalDurationSeconds Int?
  overallScore         Float?
  strengths            String[]            @default([])
  weaknesses           String[]            @default([])
  actionItems          Json?
  fullReport           Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  responses            InterviewResponse[]

  @@index([userId])
  @@index([status])
  @@map("interview_sessions")
}

model InterviewResponse {
  id                 String           @id @default(uuid())
  sessionId          String
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId         String
  questionOrder      Int              @default(0)
  userAnswer         String           @db.Text
  userAnswerAr       String?          @db.Text
  contentScore       Float?
  structureScore     Float?
  confidenceScore    Float?
  overallScore       Float?
  feedbackText       String?          @db.Text
  feedbackTextAr     String?          @db.Text
  improvementTip     String?          @db.Text
  improvementTipAr   String?          @db.Text
  rawAiResponse      Json?
  timeTakenSeconds   Int
  startedAt          DateTime
  completedAt        DateTime
  followUpCount      Int              @default(0)
  followUpResponses  Json?
  createdAt          DateTime         @default(now())

  @@index([sessionId])
  @@index([questionId])
  @@map("interview_responses")
}
