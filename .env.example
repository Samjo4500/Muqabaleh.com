# ══════════════════════════════════════════════════════════════
# Muqabaleh — Environment Variables
# ══════════════════════════════════════════════════════════════
#
# QUICK START: Set only DEMO_MODE=true to preview the full site
# without any API keys. Landing page, pricing, admin dashboard,
# and demo interview all work in demo mode.
#
# ══════════════════════════════════════════════════════════════

# ─── Demo Mode ───
# Set to "true" to run the entire site without API keys.
# - AI interviews use pre-written mock questions
# - TTS returns text-only (no audio)
# - PayPal shows "unavailable" message
# - Admin dashboard accessible without login
# - Demo interview works without database
DEMO_MODE=false

# ─── Database (Supabase PostgreSQL) ───
# Prefer Transaction pooler for Prisma on Vercel (port 6543) with:
#   ?pgbouncer=true&connection_limit=1&connect_timeout=10&pool_timeout=20
# Session pooler (port 5432) also works; src/lib/db.ts appends safe pool params
# when hostname is *.pooler.supabase.com if they are missing.
# Not required in DEMO_MODE=true
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[YOUR-DB-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=10&pool_timeout=20

# Direct connection (for migrations only - not used from Vercel)
# DIRECT_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Auth ───
# Required for user registration/login. Not required in DEMO_MODE.
NEXTAUTH_URL=https://muqabaleh-com.vercel.app
NEXTAUTH_SECRET=generate-a-random-secret-here

# ─── Google Cloud (Speech-to-Text + Text-to-Speech) ───
# Preferred for voice: service-account JSON (server-only; never expose client-side).
# Enable Cloud Speech-to-Text + Cloud Text-to-Speech on the GCP project.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_API_KEY=
# Optional alias still accepted by helpers:
GOOGLE_TTS_API_KEY=

# ─── Google Gemini / AI Studio (interview brain + scoring) ───
# Must be an AI Studio API key (usually starts with AIza), NOT a generic Cloud OAuth secret.
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public app URL
NEXT_PUBLIC_APP_URL=https://muqabaleh.com
NEXT_PUBLIC_SITE_URL=https://muqabaleh.com

# ─── Azure Speech Services (TTS) ───
# Optional. Falls back to built-in SDK if not set.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ─── PayPal ───
# Required for paid plans. Shows "unavailable" if not set.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional alias for PAYPAL_SECRET
# PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live — packages page shows "Test Payment Mode" when not live
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal Plan IDs (create in PayPal Business Dashboard)
PAYPAL_PLAN_ID=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_UNLIMITED=
PAYPAL_PLAN_ID_HUMAN_STD=
PAYPAL_PLAN_ID_HUMAN_PRO=

# ─── Daily.co ───
DAILY_API_KEY=
# Base64-encoded HMAC secret from Daily webhook registration
DAILY_WEBHOOK_SECRET=

# ─── Cron ───
# Required for /api/email/cron, /api/email/daily-summary, /api/jobs/fetch-cron
# Also authorizes /api/interview/coach/health (or SUPER_ADMIN session)
CRON_SECRET=
# Same CRON_SECRET must be set as a GitHub Actions repo secret for
# .github/workflows/daily-mena-jobs.yml (daily full ATS sweep).
# Optional GitHub variable SITE_URL (default https://muqabaleh.com).

# ─── Email (Brevo) — ALL transactional mail ───
# Welcome, password reset, receipts, passport, queue. Do not add Resend.
# Authenticate muqabaleh.com in Brevo; send from system/passport senders.
# RESEND_API_KEY is unused (legacy). Do not set it.
# Vercel: enable BREVO_API_KEY for Production AND Preview.
BREVO_API_KEY=
ADMIN_EMAIL=you@muqabaleh.com
# Min 24 chars — empty disables /api/email/send (fail closed)
EMAIL_INTERNAL_SECRET=
# Optional: enable demo partner login (min 24 chars). Leave unset in production.
# DEMO_PARTNER_LOGIN_SECRET=

# ─── Analytics (optional) ───
# GA4 Measurement ID (G-XXXXXXXX). Inlined at build time — set on Vercel before deploy.
# Rendered in <head> on all locale routes. Consent Mode stays denied until cookie accept.
# Vercel: set NEXT_PUBLIC_GA_ID for Preview + Production, then redeploy.
NEXT_PUBLIC_GA_ID=
# Optional Meta Pixel (blocked until analytics cookie consent)
# NEXT_PUBLIC_META_PIXEL_ID=

# ─── Error tracking (optional) ───
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Jeannie job discovery (optional — curated MENA feed always runs) ───
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# RapidAPI JSearch (preferred for MENA query strings)
JSEARCH_API_KEY=
# Alias accepted by the same provider
RAPIDAPI_KEY=

# PayPal Jeannie plan IDs (Subscriptions)
PAYPAL_PLAN_ID_JEANNIE=
PAYPAL_PLAN_ID_JEANNIE_PRO=
NEXT_PUBLIC_PAYPAL_JEANNIE_SUBSCRIPTIONS=


# ─── B2B console ───
# Default is preview (reads live, writes locked).
# Set BOTH for full unlock (client needs NEXT_PUBLIC_*, server accepts either):
# NEXT_PUBLIC_B2B_CONSOLE_LIVE=true
# B2B_CONSOLE_LIVE=true
